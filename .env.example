# ── API ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/bookquest
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

# ── Auth ──────────────────────────────────────────────────────────────
# The BotFather token. Every session is derived from an HMAC keyed by it, so
# the API refuses to start without one.
TELEGRAM_BOT_TOKEN=

# At least 32 characters. Rotating it signs everyone out — which is the
# intended emergency action. Generate with: openssl rand -hex 32
JWT_SECRET=

# Optional. Defaults shown.
# JWT_EXPIRES_IN_DAYS=7
# AUTH_INIT_DATA_MAX_AGE_SECONDS=3600

# The entire admin model: comma-separated Telegram user ids. Changing an admin
# is an edit here plus a restart — there is no endpoint that grants a role.
ADMIN_TELEGRAM_IDS=

# ── Rate limits (optional; defaults shown) ────────────────────────────
# RATE_LIMIT_REGISTER_PER_HOUR=5
# RATE_LIMIT_AUTH_PER_MINUTE=20
# RATE_LIMIT_GLOBAL_PER_MINUTE=300

# Absolute URL of the web app, for certificate links and bot messages.
# WEB_APP_URL=http://localhost:5173

# ── Web (Vite: only VITE_* reaches the browser) ───────────────────────
VITE_API_URL=http://localhost:4000/api/v1

# Absolute URL of the public website. Shown as "Open on web" in the Mini App's
# top bar, and only there — on the web the app already is this URL. Leave it
# unset and the link is simply not offered.
# VITE_WEB_URL=http://localhost:5173

# Development aid, off by default. 'true' or '1' makes the web app answer its
# own API calls from fixtures instead of the network, so the screens behind a
# session — registration, the profile, the certificate, the admin area — can be
# built and seen without a real TELEGRAM_BOT_TOKEN. Never set it for a real
# build: with the flag unset the mock is dropped from the bundle entirely.
# Usage: VITE_MOCK_API=true pnpm --filter @bookquest/web dev
# VITE_MOCK_API=true
