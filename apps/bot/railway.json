{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm turbo run build --filter=@bookquest/bot",
    "watchPatterns": ["apps/bot/**", "packages/shared/**", "pnpm-lock.yaml", "package.json"]
  },
  "deploy": {
    "startCommand": "node apps/bot/dist/bot.js",
    "restartPolicyType": "ALWAYS",
    "overlapSeconds": 0,
    "drainingSeconds": 5
  }
}
