{
  "name": "@bookquest/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "seed:results": "tsx --env-file-if-exists=../../.env src/scripts/seed-results.ts",
    "migrate:audit": "tsx --env-file-if-exists=../../.env src/scripts/migrate-audit-fixes.ts",
    "migrate:quiz": "tsx --env-file-if-exists=../../.env src/scripts/migrate-quiz.ts",
    "seed:quiz": "tsx --env-file-if-exists=../../.env src/scripts/seed-quiz.ts",
    "seed:quiz:demo": "tsx --env-file-if-exists=../../.env src/scripts/seed-quiz-demo.ts",
    "drill:quiz": "tsx --env-file-if-exists=../../.env src/scripts/quiz-drill.ts",
    "reclassify:interactions": "tsx --env-file-if-exists=../../.env src/scripts/reclassify-interactions.ts",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.5.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@bookquest/shared": "workspace:*",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "mongoose": "^9.9.5",
    "multer": "^2.4.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "satori": "^0.63.2",
    "zod": "^4.5.4"
  }
}
